# Copy to .env for local development. Never commit real keys.
# Placeholders only.

# Provider: openai_compatible | anthropic | ollama | fake
SELFLEARN_PROVIDER=openai_compatible
# OpenAI-compatible base URL (for openai_compatible provider)
SELFLEARN_BASE_URL=
# API key (or leave empty for local servers needing no key)
SELFLEARN_API_KEY=
# Model name (comes from config, never hard-coded in code)
SELFLEARN_MODEL=
# Optional: fallbacks honored are OPENAI_API_KEY and ANTHROPIC_API_KEY.

# Server
SELFLEARN_API_TOKEN=
SELFLEARN_DB_PATH=./data/selflearn.db
SELFLEARN_LOG_LEVEL=INFO
